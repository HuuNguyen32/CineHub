<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    tools:context=".presentation.views.home.AccountFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="40dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="@dimen/_110sdp"
                android:clipToOutline="true"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_bg"
                android:src="@drawable/cprofile" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="Nguyễn Hữu Nguyên"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nguyennv@gmail.com"
                android:textColor="@color/gray_60"
                android:layout_marginTop="@dimen/_4sdp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Menu section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPersonalInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="20dp"
                android:focusable="true"
                app:drawableEndCompat="@drawable/ic_arrow_right"
                app:drawableStartCompat="@drawable/baseline_account_circle_24"
                app:drawableTint="@color/aqua"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="Thông tin cá nhân"
                android:textColor="@color/aqua"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="56dp" />

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="20dp"
                android:focusable="true"
                app:drawableEndCompat="@drawable/ic_arrow_right"
                app:drawableStartCompat="@drawable/baseline_local_movies_24"
                app:drawableTint="@color/aqua"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="Lịch sử đặt vé"
                android:textColor="@color/aqua"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="56dp" />

            <TextView
                android:id="@+id/tvChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="20dp"
                android:focusable="true"
                app:drawableEndCompat="@drawable/ic_arrow_right"
                app:drawableStartCompat="@drawable/outline_passkey_24"
                app:drawableTint="@color/aqua"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="Đổi mật khẩu"
                android:textColor="@color/aqua"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="56dp" />

            <TextView
                android:id="@+id/tvSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="20dp"
                android:focusable="true"
                app:drawableEndCompat="@drawable/ic_arrow_right"
                app:drawableStartCompat="@drawable/outline_manufacturing_24"
                app:drawableTint="@color/aqua"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="Cài đặt ứng dụng"
                android:textColor="@color/aqua"
                android:textSize="18sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="56dp" />

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/outline_logout_24"
                android:drawablePadding="20dp"
                app:drawableTint="@color/red"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="Đăng xuất"
                android:textColor="@color/red"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Version -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="Phiên bản 1.0.24"
            android:textColor="#BDBDBD"
            android:textSize="14sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>